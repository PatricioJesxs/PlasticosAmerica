# =============================================================================
# Plásticos América — variables de entorno
# Copia este archivo como `.env` (backend) y ajusta los valores.
# En Docker Compose, las variables ya se inyectan desde docker-compose.yml.
# =============================================================================

# --- Aplicación -------------------------------------------------------------
APP_NAME=Plásticos América API
ENVIRONMENT=production
DEBUG=false

# --- Base de datos ----------------------------------------------------------
# SQLite (desarrollo):
# DATABASE_URL=sqlite:///./plasticos_america.db
# PostgreSQL (producción):
DATABASE_URL=postgresql+psycopg2://plasticos:plasticos@db:5432/plasticos_america

# --- Seguridad --------------------------------------------------------------
# Genera una clave segura con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_DAYS_REMEMBER=30

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,https://plasticosamerica.cl,https://www.plasticosamerica.cl

# --- Google Sign-In ---------------------------------------------------------
# Client ID de Google Cloud Console (opcional). Sin valor el botón queda deshabilitado.
GOOGLE_CLIENT_ID=

# --- Administrador inicial --------------------------------------------------
# Se crea automáticamente en el primer arranque si no existe.
ADMIN_EMAIL=admin@plasticosamerica.cl
ADMIN_PASSWORD=Admin1234!
ADMIN_NOMBRE=Administrador Plásticos América
ADMIN_RUT=11.111.111-1

# --- Frontend (se inyecta en el build de Next.js) ---------------------------
# URL pública de la API. En producción usa el dominio real del backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
